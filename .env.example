# ─── Sanity CMS ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=                        # write-access token for Sanity Mutations API

# ─── Medusa Backend ───────────────────────────────────────────────────────────
NEXT_PUBLIC_MEDUSA_BACKEND_URL=          # e.g. https://api.yourdomain.com
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=      # from Medusa admin → Settings → API keys
MEDUSA_ADMIN_SECRET=                     # internal API secret (never expose to browser)

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                       # sk_live_... or sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=      # pk_live_... or pk_test_...
STRIPE_WEBHOOK_SECRET=                   # whsec_... (from Stripe Dashboard → Webhooks)

# ─── Supabase / PostgreSQL ────────────────────────────────────────────────────
SUPABASE_URL=                            # https://xxxx.supabase.co
SUPABASE_ANON_KEY=                       # safe for browser (RLS enforced)
SUPABASE_SERVICE_ROLE_KEY=              # NEVER expose — server-only, bypasses RLS
DATABASE_URL=                            # postgres://... (for Medusa backend)

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_API_SECRET=                        # random 32+ char secret for /api/admin/* routes
ADMIN_EMAIL=                             # email address to receive hold notifications
CRON_SECRET=                             # Vercel Cron auth token (set in Vercel project settings)

# ─── Email (Resend — free tier: 3,000 emails/month) ──────────────────────────
RESEND_API_KEY=                          # re_... from resend.com
RESEND_FROM_EMAIL=                       # e.g. noreply@yourdomain.com

# ─── Cold-Storage Backup (Boundary 3) ────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=                   # 64-char hex string (32 bytes AES-256 key)
BACKUP_DESTINATION_WEBHOOK=             # POST endpoint that accepts the encrypted blob
