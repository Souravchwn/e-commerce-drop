{
  "compilerOptions": {
    "target":          "ES2021",
    "module":          "CommonJS",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata":  true,
    "esModuleInterop": true,
    "strict":          true,
    "skipLibCheck":    true,
    "outDir":          "dist",
    "rootDir":         "src"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
